# Azure AI Foundry project endpoint (from "Call in code" on your agent's Playground page)
# e.g. https://<your-project>.services.ai.azure.com/api/projects/<project-name>
AZURE_PROJECT_ENDPOINT=

# Agent identity, as registered in Foundry
AZURE_AGENT_NAME=jk-service-now-opsagent
AZURE_AGENT_VERSION=3
AZURE_KNOWLEDGE_BASE=jk-service-now-kb

# Auth: DefaultAzureCredential is used, so no key lives in this app.
# Locally: run `az login` before starting the server.
# In Azure (App Service / Container Apps): assign a managed identity with
# access to the Foundry project instead.

# App
APP_ENVIRONMENT=Development
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO
